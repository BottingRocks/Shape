{
  "contract_version": 2,
  "dispatch": "shape_call_v2(operation,request_json)",
  "legacy": "shape_call unchanged (21 commands, original defaults)",
  "envelope": {
    "success": {
      "ok": true,
      "value": "operation result"
    },
    "failure": {
      "ok": false,
      "error": {
        "code": "invalid_request|unknown_command|failed|panic",
        "message": "string"
      }
    }
  },
  "cache": {
    "default": {
      "mode": "disabled"
    },
    "forms": [
      {
        "mode": "disabled"
      },
      {
        "mode": "directory",
        "directory": "/absolute/or/relative/path"
      },
      {
        "mode": "environment"
      }
    ],
    "semantics": "Per-call, no environment mutation. Disabled performs no disk cache IO. Environment explicitly reads legacy SHAPE_KERNEL_CACHE/default. Directory validates exact source identity. Loaded handles reuse memory independently of disk policy."
  },
  "defaults": {
    "trace_program": {
      "name": "seed.js",
      "steps": 1000000,
      "thread_cleanup": true,
      "no_cleanup": false,
      "check_reuse": false,
      "jobs": null,
      "quiet": true
    },
    "thread": {
      "steps": 1000000,
      "self_check": false,
      "outline": true,
      "reverse_sides": false,
      "partial": false
    },
    "corpus": {
      "steps": 1000000,
      "jobs": 1,
      "cleanup": false,
      "limit": null
    },
    "artifact_compile": {
      "input_kind": "program",
      "float_byte_order": "little",
      "direct": false
    },
    "decode": {
      "verify": false,
      "metadata": false
    },
    "explain": {
      "verify": false
    },
    "client": {
      "timeout_ms": 30000,
      "connect_timeout_ms": 10000,
      "max_body_bytes": 33554432,
      "max_redirects": 5
    },
    "naming": {
      "rename": false
    },
    "signals_schema": {
      "layouts_only": false,
      "finder_roles": true,
      "name": null
    },
    "serializer": {
      "keysets_to_omit": [

      ],
      "depth_bound": null,
      "missing_sentinel_extension": false,
      "opaque_extensions": false,
      "limits": {
        "max_bytes": 16777216,
        "max_entries": 65536,
        "max_depth": 128
      }
    }
  },
  "wire": {
    "bytes": "JSON arrays of u8 (0..255), never base64",
    "integers": "Exact JSON integer tokens, signed/unsigned 64-bit; consumers must preserve tokens (no IEEE double conversion)",
    "pack_number": "16 hexadecimal IEEE754 bit digits in PackValue {kind:\"number\",value:\"...\"}",
    "documents": "Nested documents may be objects or JSON strings. source is always text; absent/null optional fields use defaults, direct must be boolean if present.",
    "artifacts": "Versioned core artifact JSON, caller persists; compact schema is descriptive, not executable",
    "schema_sources": [
      "src/sdk/facade.rs",
      "src/sdk/extensions.rs",
      "src/signals/decode",
      "src/signals/payload"
    ]
  },
  "handles": {
    "decode": {
      "load": "shape_artifact_load(bytes,len,error_out)",
      "call": "shape_artifact_call(handle,method,request)",
      "free": "shape_artifact_free(handle)",
      "aliases": "ABI aliases of shape_generator_*; immutable validated once; concurrent calls permitted; wait before free",
      "methods": {
        "decode": "{capture:CaptureHeaders,session?:Session,verify?:bool,metadata?:bool} -> DecodedPayload",
        "encode": "{signals?:NamedSignals,decoded?:DecodedPayload,session?:Session} -> CaptureHeaders (exactly one input)",
        "explain": "{decoded:DecodedPayload,signal:string,session?:Session,verify?:bool} -> NamedSignal",
        "schema": "{} -> CompactSeedSchema",
        "artifact": "{} -> DecodeArtifact"
      },
      "compile": "ShapeArtifact *shape_artifact_compile(const char *request_json, char **error_out)",
      "compile_contract": "Same JSON object request and defaults as v2 artifact.compile. NULL request means {} (missing fields -> invalid_request), invalid UTF-8/JSON -> invalid_request. Success returns owned already compiled/validated handle and clears *error_out. Failure returns NULL and sets owned error envelope when error_out is non-NULL. Caller owns any previous *error_out. No compiled-document serialization, reparsing or revalidation; transfers shared immutable validated Arc to ABI-compatible Generator. Free with shape_artifact_free; direct/result calls retain panic containment. Export only deliberately through artifact method. Legacy document-returning artifact.compile remains."
    },
    "kernel": {
      "load": "shape_kernel_load(bytes,len,error_out)",
      "call": "shape_kernel_call(handle,operation,request)",
      "free": "shape_kernel_free(handle)",
      "operations": [
        "trace.program",
        "trace.thread",
        "trace.corpus.reachable",
        "kernel.to_json"
      ],
      "semantics": "immutable parsed once, concurrent reads; trace.program requires exact raw source identity; no per-call artifact reload"
    }
  },
  "projections": {
    "Classification": "{variant:\"javascript-vm\"|\"webassembly-vm\",ops:[{handler_index,kind,nature,pops,pushes,source}]}",
    "Site": "{name,launcher_url,base_url,seed_param,protocol:\"async_launcher\"|\"single_file\"|\"direct_kernel\",status:\"validated\"|\"reference\",headers:[[name,value]]}",
    "ClientConfig": "{timeout_ms,connect_timeout_ms,max_body_bytes,max_redirects}; requests construct bounded native reqwest client; callers needing injected client fetch bytes themselves then seeds.parse/import",
    "domain_results": "Non-Serde results are projected centrally, never Debug strings. PipelineReport and HandlerTemplate use their native Serde schemas; portable source reconstruction is also supported. PrefixTraceReport is replaced by explicit replay for corpus.fingerprint.",
    "naming_rename": "Explicit summary of semantic rewrite and plan; Rust-specific diagnostics/outcome/anonymous/local rewrite objects are not returned by this projection."
  },
